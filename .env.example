APP_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql+psycopg://dcv:dcv@localhost:5432/dcv
CORS_ORIGINS=http://localhost:3000
K8S_ENABLED=true
RUNNER_IMAGE_PYTHON=dcv-runner-python:dev
RUNNER_IMAGE_NODE=dcv-runner-node:dev

# AI
AI_ENABLED=false
AI_AUTO_EXPLAIN=true
AI_MODEL=gpt-5
OPENAI_API_KEY=

# GitHub App
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_AUTO_VERIFY=true
GITHUB_PR_COMMENTS=true

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
STRIPE_SUCCESS_URL=http://localhost:3000/?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/?billing=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:3000

# Local development identity. Replace with an IdP before public exposure.
DEV_IDENTITY_EMAIL=owner@local.dcv
DEV_IDENTITY_NAME=Local Owner
DEFAULT_ORG_NAME=Local Organization
DEFAULT_ORG_SLUG=local
